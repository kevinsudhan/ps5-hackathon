{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "backend/.venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "promisegraph.api:app", "--app-dir", "backend", "--port", "8000", "--reload", "--reload-dir", "backend/promisegraph"],
      "port": 8000,
      "url": "http://localhost:8000"
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "port": 5173
    },
    {
      "name": "api-globe",
      "runtimeExecutable": "backend/.venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "promisegraph.api:app", "--app-dir", "backend", "--port", "8011"],
      "port": 8011,
      "url": "http://localhost:8011"
    },
    {
      "name": "web-globe",
      "runtimeExecutable": "powershell",
      "runtimeArgs": ["-NoProfile", "-Command", "$env:PG_API='http://127.0.0.1:8011'; Set-Location frontend; npx vite --port 5181"],
      "port": 5181
    },
    {
      "name": "api-agents",
      "runtimeExecutable": "backend/.venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "promisegraph.api:app", "--app-dir", "backend", "--port", "8012"],
      "port": 8012,
      "url": "http://localhost:8012"
    },
    {
      "name": "web-agents",
      "runtimeExecutable": "powershell",
      "runtimeArgs": ["-NoProfile", "-Command", "$env:PG_API='http://127.0.0.1:8012'; npm --prefix frontend run dev -- --port 5182"],
      "port": 5182
    },
    {
      "name": "api-timeline",
      "runtimeExecutable": "backend/.venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "promisegraph.api:app", "--app-dir", "backend", "--port", "8013"],
      "port": 8013,
      "url": "http://localhost:8013"
    },
    {
      "name": "web-timeline",
      "runtimeExecutable": "powershell",
      "runtimeArgs": ["-NoProfile", "-Command", "$env:PG_API='http://127.0.0.1:8013'; Set-Location frontend; npx vite --port 5183"],
      "port": 5183
    }
  ]
}
